diff --git a/apps/api/src/infrastructure/db/schemaCheck.ts b/apps/api/src/infrastructure/db/schemaCheck.ts
new file mode 100644
index 0000000..fbb76e4
--- /dev/null
+++ b/apps/api/src/infrastructure/db/schemaCheck.ts
@@ -0,0 +1,40 @@
+import { getTableName, is, sql, Table } from 'drizzle-orm';
+import type { AppDatabase } from './index.js';
+import * as schema from './schema.js';
+
+export interface SchemaStatus {
+  ok: boolean;
+  missingTables: string[];
+  /** Set when the check itself could not run (e.g. database unreachable). */
+  error?: string;
+}
+
+/**
+ * Compares the tables the code expects (everything exported from schema.ts)
+ * with the tables that actually exist in the connected database.
+ *
+ * This exists because "I pulled new code but forgot to run `pnpm db:migrate`"
+ * is the most common way a feature that works in tests breaks in a real
+ * environment. Instead of discovering it as a vague 500 deep inside a request,
+ * the server now says so at startup and on /health.
+ */
+export async function checkSchema(db: AppDatabase): Promise<SchemaStatus> {
+  const expected = (Object.values(schema) as unknown[])
+    .filter((v): v is Table => is(v, Table))
+    .map((t) => getTableName(t));
+
+  try {
+    const rows = (await db.execute(
+      sql`select table_name from information_schema.tables where table_schema = 'public'`,
+    )) as unknown as Array<{ table_name: string }>;
+    const existing = new Set(rows.map((r) => r.table_name));
+    const missingTables = expected.filter((t) => !existing.has(t));
+    return { ok: missingTables.length === 0, missingTables };
+  } catch (e) {
+    return {
+      ok: false,
+      missingTables: [],
+      error: e instanceof Error ? e.message.split('\n')[0] : String(e),
+    };
+  }
+}
