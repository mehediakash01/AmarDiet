diff --git a/apps/web/lib/sync/useSyncStatus.ts b/apps/web/lib/sync/useSyncStatus.ts
new file mode 100644
index 0000000..7845bbe
--- /dev/null
+++ b/apps/web/lib/sync/useSyncStatus.ts
@@ -0,0 +1,61 @@
+'use client';
+
+import { useCallback, useEffect, useState } from 'react';
+import { liveQuery } from 'dexie';
+import { db } from '../db/db';
+import { syncEngine } from './syncEngine';
+
+export type SyncState = 'synced' | 'syncing' | 'pending' | 'offline' | 'error';
+
+/**
+ * A truthful view of "is my data safe on the server?":
+ *  - reads the REAL number of unsent changes from the local queue
+ *  - reflects what the sync engine is doing right now
+ *  - retries on its own while changes are waiting and the device is online
+ */
+export function useSyncStatus() {
+  const [online, setOnline] = useState(true);
+  const [pending, setPending] = useState(0);
+  const [engine, setEngine] = useState(syncEngine.getStatus());
+
+  useEffect(() => {
+    setOnline(navigator.onLine);
+    const goOnline = () => setOnline(true);
+    const goOffline = () => setOnline(false);
+    window.addEventListener('online', goOnline);
+    window.addEventListener('offline', goOffline);
+
+    const sub = liveQuery(() => db.syncQueue.where('status').equals('pending').count()).subscribe({
+      next: setPending,
+      error: () => undefined,
+    });
+    const unsubscribe = syncEngine.subscribe(() => setEngine({ ...syncEngine.getStatus() }));
+
+    // Changes left over from a previous session shouldn't wait for the next edit.
+    syncEngine.triggerSync().catch(() => undefined);
+
+    return () => {
+      window.removeEventListener('online', goOnline);
+      window.removeEventListener('offline', goOffline);
+      sub.unsubscribe();
+      unsubscribe();
+    };
+  }, []);
+
+  useEffect(() => {
+    if (!online || pending === 0) return;
+    const id = setInterval(() => syncEngine.triggerSync().catch(() => undefined), 30_000);
+    return () => clearInterval(id);
+  }, [online, pending]);
+
+  const retry = useCallback(() => {
+    syncEngine.triggerSync().catch(() => undefined);
+  }, []);
+
+  let state: SyncState = 'synced';
+  if (!online) state = 'offline';
+  else if (engine.isSyncing) state = 'syncing';
+  else if (pending > 0) state = engine.lastRunHadFailures ? 'error' : 'pending';
+
+  return { state, pending, online, retry };
+}
