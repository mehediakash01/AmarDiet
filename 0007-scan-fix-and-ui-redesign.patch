@@ -0,0 +1,159 @@
+'use client';
+
+import Link from 'next/link';
+import { usePathname } from 'next/navigation';
+import {
+  BookOpen,
+  Camera,
+  CalendarDays,
+  LayoutDashboard,
+  ShieldCheck,
+  TrendingUp,
+  UserRound,
+  Utensils,
+  type LucideIcon,
+} from 'lucide-react';
+import { useNutritionStore } from '@/lib/store/useNutritionStore';
+import { slotForNow } from '@/lib/date';
+import { SyncStatus } from '@/components/ui/SyncStatus';
+
+interface NavItem {
+  href: string;
+  label: string;
+  icon: LucideIcon;
+}
+
+const MAIN_NAV: NavItem[] = [
+  { href: '/dashboard', label: 'Dashboard', icon: LayoutDashboard },
+  { href: '/tracker', label: 'Diary', icon: BookOpen },
+  { href: '/plan', label: 'Diet plan', icon: CalendarDays },
+  { href: '/progress', label: 'Progress', icon: TrendingUp },
+];
+
+// The admin screen has no authentication yet, so it is not advertised in
+// production builds (it is still reachable by URL — real auth is still needed).
+const SHOW_ADMIN =
+  process.env.NODE_ENV !== 'production' || process.env.NEXT_PUBLIC_SHOW_ADMIN === 'true';
+
+function Logo({ className = '' }: { className?: string }) {
+  return (
+    <Link href="/dashboard" className={`flex items-center gap-2.5 ${className}`}>
+      <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-primary shadow-soft">
+        <Utensils className="h-[18px] w-[18px] text-accent" />
+      </span>
+      <span className="whitespace-nowrap font-serif text-xl font-bold text-primary">Thali Tracker</span>
+    </Link>
+  );
+}
+
+export function AppShell({ children }: { children: React.ReactNode }) {
+  const pathname = usePathname();
+  const openMealScan = useNutritionStore((s) => s.openMealScan);
+  const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
+
+  const desktopItems: NavItem[] = [
+    ...MAIN_NAV,
+    { href: '/onboarding', label: 'Profile & goals', icon: UserRound },
+    ...(SHOW_ADMIN ? [{ href: '/admin', label: 'Admin', icon: ShieldCheck }] : []),
+  ];
+
+  return (
+    <>
+      {/* ---------- Desktop sidebar ---------- */}
+      <aside className="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-border/60 bg-surface px-4 py-6 lg:flex">
+        <Logo className="px-2" />
+
+        <nav className="mt-8 flex flex-col gap-1" aria-label="Main">
+          {desktopItems.map((item) => {
+            const Icon = item.icon;
+            const active = isActive(item.href);
+            return (
+              <Link
+                key={item.href}
+                href={item.href}
+                aria-current={active ? 'page' : undefined}
+                className={`group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition ${
+                  active
+                    ? 'bg-primary text-surface shadow-soft'
+                    : 'text-dark/80 hover:bg-sand/80 hover:text-primary'
+                }`}
+              >
+                <Icon className={`h-[18px] w-[18px] ${active ? 'text-accent' : 'text-muted group-hover:text-primary'}`} />
+                {item.label}
+              </Link>
+            );
+          })}
+        </nav>
+
+        <div className="mt-auto space-y-3">
+          <button onClick={() => openMealScan(slotForNow())} className="btn-ai w-full py-3">
+            <Camera className="h-4 w-4" /> Scan a meal
+          </button>
+          <SyncStatus />
+        </div>
+      </aside>
+
+      {/* ---------- Mobile top bar ---------- */}
+      <header className="sticky top-0 z-40 flex items-center justify-between gap-3 border-b border-border/60 bg-surface px-4 py-3 lg:hidden">
+        <Logo />
+        <div className="flex items-center gap-2">
+          <SyncStatus variant="pill" />
+          <Link
+            href="/onboarding"
+            aria-label="Profile and goals"
+            className="rounded-xl p-2 text-muted transition hover:bg-sand hover:text-primary"
+          >
+            <UserRound className="h-5 w-5" />
+          </Link>
+        </div>
+      </header>
+
+      {/* ---------- Content ---------- */}
+      <main className="lg:pl-64">
+        <div key={pathname} className="mx-auto w-full max-w-6xl animate-fade-up px-4 pb-32 pt-6 sm:px-6 lg:px-10 lg:pb-14 lg:pt-10">
+          {children}
+        </div>
+      </main>
+
+      {/* ---------- Mobile bottom tab bar ---------- */}
+      <nav
+        aria-label="Main"
+        className="fixed inset-x-0 bottom-0 z-40 border-t border-border/60 bg-surface pb-[env(safe-area-inset-bottom)] lg:hidden"
+      >
+        <ul className="mx-auto grid max-w-md grid-cols-5 items-end px-2">
+          {[MAIN_NAV[0], MAIN_NAV[1], null, MAIN_NAV[2], MAIN_NAV[3]].map((item, i) => {
+            if (!item) {
+              return (
+                <li key="scan" className="flex justify-center">
+                  <button
+                    onClick={() => openMealScan(slotForNow())}
+                    aria-label="Scan a meal"
+                    className="-mt-6 flex h-14 w-14 items-center justify-center rounded-full bg-accent text-white shadow-glow ring-4 ring-surface transition active:scale-95"
+                  >
+                    <Camera className="h-6 w-6" />
+                  </button>
+                </li>
+              );
+            }
+            const Icon = item.icon;
+            const active = isActive(item.href);
+            return (
+              <li key={item.href + i}>
+                <Link
+                  href={item.href}
+                  aria-current={active ? 'page' : undefined}
+                  className={`flex flex-col items-center gap-0.5 py-2.5 text-[11px] font-medium transition ${
+                    active ? 'text-primary' : 'text-muted'
+                  }`}
+                >
+                  <Icon className={`h-5 w-5 ${active ? 'text-primary' : ''}`} strokeWidth={active ? 2.4 : 2} />
+                  {item.label}
+                </Link>
+              </li>
+            );
+          })}
+        </ul>
+      </nav>
+    </>
+  );
+}
