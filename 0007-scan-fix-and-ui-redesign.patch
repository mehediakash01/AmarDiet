diff --git a/apps/web/components/ui/EnergyRing.tsx b/apps/web/components/ui/EnergyRing.tsx
new file mode 100644
index 0000000..9420d27
--- /dev/null
+++ b/apps/web/components/ui/EnergyRing.tsx
@@ -0,0 +1,90 @@
+'use client';
+
+import { useEffect, useId, useState } from 'react';
+
+interface EnergyRingProps {
+  consumed: number;
+  target: number;
+  size?: number;
+  /** 'dark' = drawn on the deep-green hero card. */
+  tone?: 'dark' | 'light';
+}
+
+/** Calorie ring: fills as you eat, turns red only when you go over the target. */
+export function EnergyRing({ consumed, target, size = 200, tone = 'dark' }: EnergyRingProps) {
+  const gradId = useId();
+  const stroke = 14;
+  const radius = (size - stroke) / 2;
+  const circumference = 2 * Math.PI * radius;
+  const ratio = target > 0 ? consumed / target : 0;
+  const over = consumed > target;
+  const fill = Math.min(1, ratio);
+
+  // Start empty and animate to the real value after mount, so the ring "draws in".
+  const [drawn, setDrawn] = useState(0);
+  useEffect(() => {
+    const raf = requestAnimationFrame(() => setDrawn(fill));
+    return () => cancelAnimationFrame(raf);
+  }, [fill]);
+
+  const dark = tone === 'dark';
+  const remaining = Math.max(0, Math.round(target - consumed));
+  const overBy = Math.round(consumed - target);
+
+  return (
+    <div
+      className="relative flex-shrink-0"
+      style={{ width: size, height: size }}
+      role="img"
+      aria-label={
+        over ? `${overBy} calories over your target` : `${remaining} calories left of ${Math.round(target)}`
+      }
+    >
+      <svg width={size} height={size} className="-rotate-90">
+        <defs>
+          <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="100%">
+            {over ? (
+              <>
+                <stop offset="0%" stopColor="#E28A74" />
+                <stop offset="100%" stopColor="#B0472F" />
+              </>
+            ) : (
+              <>
+                <stop offset="0%" stopColor={dark ? '#F3D08A' : '#E0A945'} />
+                <stop offset="100%" stopColor={dark ? '#C98A2C' : '#1F4D3E'} />
+              </>
+            )}
+          </linearGradient>
+        </defs>
+        <circle
+          cx={size / 2}
+          cy={size / 2}
+          r={radius}
+          fill="none"
+          stroke={dark ? 'rgba(255,255,255,0.14)' : '#EFE9D9'}
+          strokeWidth={stroke}
+        />
+        <circle
+          cx={size / 2}
+          cy={size / 2}
+          r={radius}
+          fill="none"
+          stroke={`url(#${gradId})`}
+          strokeWidth={stroke}
+          strokeLinecap="round"
+          strokeDasharray={circumference}
+          strokeDashoffset={circumference * (1 - drawn)}
+          style={{ transition: 'stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1)' }}
+        />
+      </svg>
+      <div className="absolute inset-0 flex flex-col items-center justify-center text-center">
+        <span className={`num font-serif text-4xl font-bold leading-none ${dark ? 'text-white' : 'text-primary'}`}>
+          {over ? `+${overBy}` : remaining}
+        </span>
+        <span className={`mt-1.5 text-xs font-medium ${dark ? 'text-white/70' : 'text-muted'}`}>
+          {over ? 'kcal over' : 'kcal left'}
+        </span>
+      </div>
+    </div>
+  );
+}
