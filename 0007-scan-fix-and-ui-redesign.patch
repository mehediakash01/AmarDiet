 let inFlightRequest: Promise<string> | null = null;
+let verifiedId: string | null = null;
+
+class InvalidCachedIdError extends Error {}
+
+/**
+ * The id cached in this browser may not exist on the server any more — e.g. the
+ * database was reset, restored, or you switched from the in-memory dev server to
+ * a real one. Every write tied to that id would then fail with a foreign-key
+ * error. POST /api/subscribers is idempotent for a given id, so calling it is a
+ * safe way to make sure the account row exists ("self-healing").
+ *
+ * Offline-first: if the server can't be reached we simply carry on with the
+ * cached id and verify again on the next load.
+ */
+async function ensureRegistered(id: string): Promise<void> {
+  if (verifiedId === id) return;
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 5000);
+  try {
+    const res = await fetch(`${getApiBaseUrl()}/api/subscribers`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ id }),
+      signal: controller.signal,
+    });
+    if (res.ok) {
+      verifiedId = id;
+      return;
+    }
+    if (res.status === 400) {
+      // The cached value isn't a valid id at all (corrupted) — start over.
+      window.localStorage.removeItem(STORAGE_KEY);
+      throw new InvalidCachedIdError();
+    }
+  } catch (e) {
+    if (e instanceof InvalidCachedIdError) throw e;
+    // Offline or slow server — keep working with the cached id.
+  } finally {
+    clearTimeout(timer);
+  }
+}
 
