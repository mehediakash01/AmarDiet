diff --git a/apps/web/lib/api/errors.ts b/apps/web/lib/api/errors.ts
new file mode 100644
index 0000000..4d978ba
--- /dev/null
+++ b/apps/web/lib/api/errors.ts
@@ -0,0 +1,107 @@
+/**
+ * Turns "something failed" into words a person can act on. Raw server text
+ * ("Internal Server Error", SQL, stack traces) must never reach the screen —
+ * the server logs the real cause; the user gets what happened + what to do.
+ */
+
+export interface FriendlyError {
+  title: string;
+  detail: string;
+}
+
+export type FailureContext = 'scan' | 'plan' | 'generic';
+
+export interface Failure {
+  /** HTTP status, when the server answered at all. */
+  status?: number;
+  /** Request never got an answer (offline, DNS, server down, CORS). */
+  network?: boolean;
+  /** Request was abandoned because it took too long. */
+  timedOut?: boolean;
+}
+
+export class RequestTimeoutError extends Error {
+  constructor() {
+    super('Request timed out');
+    this.name = 'RequestTimeoutError';
+  }
+}
+
+/** fetch() with a hard timeout and an optional caller-supplied abort signal. */
+export async function fetchWithTimeout(
+  url: string,
+  init: RequestInit & { timeoutMs?: number } = {},
+): Promise<Response> {
+  const { timeoutMs = 60_000, signal, ...rest } = init;
+  const controller = new AbortController();
+  let timedOut = false;
+  const timer = setTimeout(() => {
+    timedOut = true;
+    controller.abort();
+  }, timeoutMs);
+  signal?.addEventListener('abort', () => controller.abort(), { once: true });
+  try {
+    return await fetch(url, { ...rest, signal: controller.signal });
+  } catch (e) {
+    if (timedOut) throw new RequestTimeoutError();
+    throw e;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+export function classifyError(e: unknown): Failure {
+  if (e instanceof RequestTimeoutError) return { timedOut: true };
+  return { network: true };
+}
+
+export function describeFailure(f: Failure, context: FailureContext = 'generic'): FriendlyError {
+  const fallbackAdvice =
+    context === 'scan'
+      ? 'You can retake the photo, or search for the food and log it manually.'
+      : 'Please try again in a moment.';
+
+  if (f.timedOut) {
+    return {
+      title: 'This is taking too long',
+      detail: `The server didn't answer in time. ${fallbackAdvice}`,
+    };
+  }
+  if (f.network || f.status === undefined) {
+    return {
+      title: "Can't reach the server",
+      detail: `Check your internet connection. Anything you've already logged is safe on this device. ${fallbackAdvice}`,
+    };
+  }
+  switch (f.status) {
+    case 400:
+    case 422:
+      return {
+        title: context === 'scan' ? "We couldn't read that photo" : 'That request was not valid',
+        detail:
+          context === 'scan'
+            ? 'Try taking it again in good light, as a JPEG, PNG or WebP image.'
+            : 'Please check what you entered and try again.',
+      };
+    case 404:
+      return { title: "We couldn't find that", detail: 'It may have been removed. Refresh and try again.' };
+    case 413:
+      return {
+        title: 'That photo is too large',
+        detail: 'Try a smaller photo — or move a little further from the plate and retake it.',
+      };
+    case 429:
+      return {
+        title: 'Too many requests',
+        detail: 'Give it a minute, then try again.',
+      };
+    default:
+      if (f.status >= 500) {
+        return {
+          title: 'Something went wrong on our side',
+          detail: `Your data is safe and this isn't your fault. ${fallbackAdvice}`,
+        };
+      }
+      return { title: 'Something went wrong', detail: fallbackAdvice };
+  }
+}
