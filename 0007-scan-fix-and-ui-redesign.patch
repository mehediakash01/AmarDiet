@@ -0,0 +1,41 @@
+import { create } from 'zustand';
+
+export type ToastKind = 'success' | 'error' | 'info';
+
+export interface Toast {
+  id: string;
+  kind: ToastKind;
+  title: string;
+  description?: string;
+}
+
+interface ToastState {
+  toasts: Toast[];
+  push: (t: Omit<Toast, 'id'>, durationMs?: number) => string;
+  dismiss: (id: string) => void;
+}
+
+let counter = 0;
+
+export const useToastStore = create<ToastState>((set, get) => ({
+  toasts: [],
+  push: (t, durationMs) => {
+    const id = `toast_${Date.now()}_${counter++}`;
+    // Keep the stack short — a burst of identical toasts is noise, not information.
+    set((s) => ({ toasts: [...s.toasts.slice(-2), { ...t, id }] }));
+    const ms = durationMs ?? (t.kind === 'error' ? 7000 : 3500);
+    setTimeout(() => get().dismiss(id), ms);
+    return id;
+  },
+  dismiss: (id) => set((s) => ({ toasts: s.toasts.filter((x) => x.id !== id) })),
+}));
+
+/** Call from anywhere (components, store actions): toast.success('Saved') */
+export const toast = {
+  success: (title: string, description?: string) =>
+    useToastStore.getState().push({ kind: 'success', title, description }),
+  error: (title: string, description?: string) =>
+    useToastStore.getState().push({ kind: 'error', title, description }),
+  info: (title: string, description?: string) =>
+    useToastStore.getState().push({ kind: 'info', title, description }),
+};
