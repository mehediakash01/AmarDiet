diff --git a/tests/integration/api-resilience.test.ts b/tests/integration/api-resilience.test.ts
new file mode 100644
index 0000000..5cd35a1
--- /dev/null
+++ b/tests/integration/api-resilience.test.ts
@@ -0,0 +1,143 @@
+import { describe, it, expect } from 'vitest';
+import { buildApp } from '../../apps/api/src/app.js';
+import { InMemoryFoodRepository } from '../../apps/api/src/modules/food/food.repository.js';
+import { FoodService } from '../../apps/api/src/modules/food/food.service.js';
+import { AiService } from '../../apps/api/src/modules/ai/ai.service.js';
+import { VisionGateway } from '../../apps/api/src/modules/ai/gateway.js';
+import type { IMealScanRepository } from '../../apps/api/src/modules/ai/meal-scan.repository.js';
+import type { IFoodLogRepository } from '../../apps/api/src/modules/food-log/food-log.repository.js';
+import { checkSchema } from '../../apps/api/src/infrastructure/db/schemaCheck.js';
+import type { VisionProvider } from '../../apps/api/src/modules/ai/providers/types.js';
+import type { MealScanResult } from '@thali/schemas';
+
+const SQL_LEAK = 'Failed query: insert into "food_logs" (secret_column) values ($1) -- password=hunter2';
+
+const GOOD_RESULT: MealScanResult = {
+  isFood: true,
+  confidence: 0.9,
+  items: [{ name: 'rice', estimatedQuantity: 150, estimatedUnit: 'g', confidence: 0.9 }],
+};
+
+async function foodService() {
+  const s = new FoodService(new InMemoryFoodRepository());
+  await s.init();
+  return s;
+}
+
+const validLogBody = {
+  id: 'log-1',
+  subscriberId: '11111111-1111-4111-8111-111111111111',
+  loggedOn: '2026-10-10',
+  mealSlot: 'lunch',
+  foodId: 'food_generic_banana',
+  foodName: 'Banana',
+  quantity: 100,
+  unit: 'g',
+  calculatedNutrition: { calories: 89, protein: 1, carbs: 23, fat: 0, fiber: 2 },
+};
+
+describe('Resilience: a scan must survive failures in its own bookkeeping', () => {
+  it('still returns the analysis when the scan-event log cannot be written (e.g. missing table / stale subscriber)', async () => {
+    const brokenLog: IMealScanRepository = {
+      record: async () => {
+        throw new Error('relation "meal_scan_events" does not exist');
+      },
+    };
+    const provider: VisionProvider = { name: 'fake', analyzeMealPhoto: async () => GOOD_RESULT };
+    const service = new AiService(new VisionGateway([provider]), brokenLog, await foodService());
+
+    const result = await service.scanMeal('any-subscriber', Buffer.from('x').toString('base64'), 'image/jpeg');
+
+    expect(result.ok).toBe(true);
+    if (result.ok) {
+      expect(result.data.status).toBe('success');
+      expect(result.data.items).toHaveLength(1);
+    }
+  });
+
+  it('also returns the honest all-providers-failed answer (not a 500) when logging is broken', async () => {
+    const brokenLog: IMealScanRepository = {
+      record: async () => {
+        throw new Error('db down');
+      },
+    };
+    const service = new AiService(new VisionGateway([]), brokenLog, await foodService());
+    const result = await service.scanMeal('s', Buffer.from('x').toString('base64'), 'image/jpeg');
+    expect(result.ok).toBe(true);
+    if (result.ok) expect(result.data.status).toBe('all_providers_failed');
+  });
+});
+
+describe('Resilience: what clients are allowed to see when the server breaks', () => {
+  it('turns an unexpected (database) failure into a generic 500 — no SQL, no secrets — with a request id', async () => {
+    const explodingRepo = new Proxy({} as IFoodLogRepository, {
+      get: () => async () => {
+        throw new Error(SQL_LEAK);
+      },
+    });
+    const app = await buildApp({ foodService: await foodService(), foodLogRepo: explodingRepo, visionProviders: [] });
+
+    const res = await app.inject({ method: 'POST', url: '/api/food-logs', payload: validLogBody });
+
+    expect(res.statusCode).toBe(500);
+    expect(res.body).not.toContain('Failed query');
+    expect(res.body).not.toContain('hunter2');
+    expect(res.body).not.toContain('secret_column');
+    const body = JSON.parse(res.body);
+    expect(body.error).toBe('internal_error');
+    expect(body.requestId).toBeTruthy();
+  });
+
+  it('still gives a helpful 400 for an EXPECTED, user-fixable problem (unknown food)', async () => {
+    const app = await buildApp({ foodService: await foodService(), visionProviders: [] });
+
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/food-logs',
+      payload: { ...validLogBody, foodId: 'does-not-exist' },
+    });
+
+    expect(res.statusCode).toBe(400);
+    expect(JSON.parse(res.body).error).toMatch(/not found/i);
+  });
+
+  it('/health reports the schema as not-applicable (rather than lying) when running in memory', async () => {
+    const app = await buildApp({ foodService: await foodService(), visionProviders: [] });
+    const body = JSON.parse((await app.inject({ method: 'GET', url: '/health' })).body);
+    expect(body.status).toBe('ok');
+    expect(body.schema).toBe('not-applicable');
+  });
+});
+
+describe('Schema check: "I forgot to run the migration" is detected, not discovered as a mystery 500', () => {
+  const fakeDb = (rows: Array<{ table_name: string }> | Error) =>
+    ({ execute: async () => (rows instanceof Error ? Promise.reject(rows) : rows) }) as never;
+
+  it('lists exactly the tables that the code expects but the database lacks', async () => {
+    const status = await checkSchema(
+      fakeDb([
+        { table_name: 'subscribers' },
+        { table_name: 'profiles' },
+        { table_name: 'food_logs' },
+        { table_name: 'diet_plans' },
+        { table_name: 'weight_logs' },
+        { table_name: 'foods' },
+        // meal_scan_events deliberately absent — the exact situation that caused the bug
+      ]),
+    );
+    expect(status.ok).toBe(false);
+    expect(status.missingTables).toEqual(['meal_scan_events']);
+  });
+
+  it('is ok when every expected table exists', async () => {
+    const all = ['subscribers', 'profiles', 'food_logs', 'diet_plans', 'weight_logs', 'foods', 'meal_scan_events'];
+    const status = await checkSchema(fakeDb(all.map((table_name) => ({ table_name }))));
+    expect(status).toEqual({ ok: true, missingTables: [] });
+  });
+
+  it('reports (does not throw) when the database cannot even be queried', async () => {
+    const status = await checkSchema(fakeDb(new Error('connection refused\nstack...')));
+    expect(status.ok).toBe(false);
+    expect(status.error).toBe('connection refused');
+  });
+});
