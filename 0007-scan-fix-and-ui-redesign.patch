diff --git a/apps/api/src/shared/errors.ts b/apps/api/src/shared/errors.ts
new file mode 100644
index 0000000..d026521
--- /dev/null
+++ b/apps/api/src/shared/errors.ts
@@ -0,0 +1,15 @@
+/**
+ * An EXPECTED business-rule failure whose message is written for the user
+ * (e.g. "Food item X not found"). Routes may safely turn these into a 4xx
+ * response with the message included.
+ *
+ * Anything that is NOT a DomainError (database errors, bugs, network faults)
+ * is unexpected and must never be echoed to the client — it propagates to the
+ * global error handler in app.ts, which logs it and replies with a generic 500.
+ */
+export class DomainError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'DomainError';
+  }
+}
