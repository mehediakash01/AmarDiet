+html {
+  scroll-behavior: smooth;
+  -webkit-text-size-adjust: 100%;
+}
+
 body {
   background-color: var(--background);
+  /* Two very soft colour washes give the flat muslin background some depth
+     without competing with content. Fixed so they don't scroll with the page. */
+  background-image:
+    radial-gradient(1100px 520px at 88% -8%, rgba(201, 138, 44, 0.11), transparent 62%),
+    radial-gradient(900px 520px at -8% 4%, rgba(31, 77, 62, 0.09), transparent 58%);
+  background-attachment: fixed;
   color: var(--foreground);
   min-height: 100vh;
   font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
   -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
 }
 
 input, select, textarea, button {
   font-family: inherit;
 }
+
+::selection {
+  background: rgba(201, 138, 44, 0.28);
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+  border-radius: 6px;
+}
+
+/* Slim, warm scrollbars instead of the default grey system ones. */
+* {
+  scrollbar-width: thin;
+  scrollbar-color: #d4cbb2 transparent;
+}
+*::-webkit-scrollbar { width: 8px; height: 8px; }
+*::-webkit-scrollbar-thumb { background: #d4cbb2; border-radius: 999px; }
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+@layer components {
+  /* ---- Surfaces ---- */
+  .card {
+    @apply bg-surface rounded-2xl border border-border/60 shadow-soft;
+  }
+  .card-hover {
+    @apply transition duration-200 hover:-translate-y-0.5 hover:shadow-lift;
+  }
+
+  /* ---- Buttons ---- */
+  .btn {
+    @apply inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold
+      transition duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-55
+      disabled:active:scale-100 select-none whitespace-nowrap;
+  }
+  .btn-sm { @apply rounded-lg px-3 py-1.5 text-xs; }
+  .btn-lg { @apply px-6 py-3 text-base; }
+  .btn-primary { @apply btn bg-primary text-surface shadow-soft hover:bg-primary-hover; }
+  .btn-accent { @apply btn bg-accent text-white shadow-soft hover:bg-accent-hover; }
+  .btn-ai {
+    @apply btn text-white shadow-soft hover:brightness-110;
+    background-image: linear-gradient(135deg, #6a4a9c 0%, #4a3270 100%);
+  }
+  .btn-outline { @apply btn border border-border bg-surface text-dark hover:bg-sand/70; }
+  .btn-ghost { @apply btn text-muted hover:bg-sand/70 hover:text-dark; }
+
+  /* ---- Form fields ---- */
+  .input {
+    @apply w-full rounded-xl border border-border bg-white px-3.5 py-2.5 text-sm text-dark
+      placeholder:text-muted/70 transition focus:border-primary focus:outline-none
+      focus:ring-4 focus:ring-primary/10;
+  }
+
+  /* ---- Small bits ---- */
+  .chip { @apply inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium; }
+  .num { font-variant-numeric: tabular-nums; }
+  /* Section label: sentence case, never ALL-CAPS (house style). */
+  .kicker { @apply text-sm font-semibold text-muted; }
+
+  .skeleton {
+    @apply rounded-xl;
+    background-color: #ece5d2;
+    background-image: linear-gradient(90deg, #ece5d2 0px, #f6f1e3 160px, #ece5d2 320px);
+    background-size: 800px 100%;
+    @apply animate-shimmer;
+  }
+}
