+++ b/apps/web/components/MealSection.tsx
@@ -0,0 +1,109 @@
+'use client';
+
+import { Camera, Cookie, Moon, Plus, Sun, Sunrise, X, type LucideIcon } from 'lucide-react';
+import type { MealSlot } from '@thali/types';
+import type { LocalFoodLogEntry } from '@/lib/db/db';
+
+export const MEAL_META: Record<MealSlot, { label: string; icon: LucideIcon; tint: string; iconColor: string }> = {
+  breakfast: { label: 'Breakfast', icon: Sunrise, tint: 'bg-accent-light', iconColor: 'text-accent' },
+  lunch: { label: 'Lunch', icon: Sun, tint: 'bg-primary-light', iconColor: 'text-primary' },
+  dinner: { label: 'Dinner', icon: Moon, tint: 'bg-secondary-light', iconColor: 'text-secondary' },
+  snack: { label: 'Snacks', icon: Cookie, tint: 'bg-sand', iconColor: 'text-muted' },
+};
+
+interface MealSectionProps {
+  slot: MealSlot;
+  entries: LocalFoodLogEntry[];
+  onAddFood: (slot: MealSlot) => void;
+  onScan: (slot: MealSlot) => void;
+  onRemove: (id: string) => void;
+}
+
+export function MealSection({ slot, entries, onAddFood, onScan, onRemove }: MealSectionProps) {
+  const meta = MEAL_META[slot];
+  const Icon = meta.icon;
+  const kcal = entries.reduce((sum, e) => sum + e.calculatedNutrition.calories, 0);
+
+  return (
+    <section className="card flex flex-col p-4 sm:p-5" aria-label={meta.label}>
+      <header className="flex items-center justify-between gap-3">
+        <div className="flex min-w-0 items-center gap-3">
+          <span className={`flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl ${meta.tint}`}>
+            <Icon className={`h-5 w-5 ${meta.iconColor}`} />
+          </span>
+          <div className="min-w-0">
+            <h3 className="font-serif text-lg font-bold leading-tight text-dark">{meta.label}</h3>
+            <p className="text-xs text-muted">
+              {entries.length === 0 ? 'Nothing logged yet' : `${entries.length} item${entries.length === 1 ? '' : 's'}`}
+            </p>
+          </div>
+        </div>
+        <div className="num flex-shrink-0 text-right">
+          <span className="font-serif text-xl font-bold text-primary">{Math.round(kcal)}</span>
+          <span className="ml-1 text-xs text-muted">kcal</span>
+        </div>
+      </header>
+
+      {entries.length === 0 ? (
+        <div className="mt-4 flex flex-1 flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-border bg-background/50 px-4 py-6 text-center">
+          <p className="text-sm text-muted">Add what you ate — snap a photo or search.</p>
+          <div className="flex gap-2">
+            <button onClick={() => onScan(slot)} className="btn-ai btn-sm">
+              <Camera className="h-3.5 w-3.5" /> Scan
+            </button>
+            <button onClick={() => onAddFood(slot)} className="btn-outline btn-sm">
+              <Plus className="h-3.5 w-3.5" /> Add food
+            </button>
+          </div>
+        </div>
+      ) : (
+        <>
+          <ul className="mt-3 divide-y divide-border/50">
+            {entries.map((item) => (
+              <li key={item.id} className="group flex items-center justify-between gap-3 py-3">
+                <div className="min-w-0">
+                  <p className="truncate text-sm font-semibold text-dark">{item.foodName || 'Food item'}</p>
+                  <p className="num mt-0.5 flex flex-wrap items-center gap-x-3 text-xs text-muted">
+                    <span>
+                      {item.quantity} {item.unit}
+                    </span>
+                    <span className="inline-flex items-center gap-1">
+                      <i className="h-1.5 w-1.5 rounded-full bg-primary" />P {Math.round(item.calculatedNutrition.protein)}g
+                    </span>
+                    <span className="inline-flex items-center gap-1">
+                      <i className="h-1.5 w-1.5 rounded-full bg-accent" />C {Math.round(item.calculatedNutrition.carbs)}g
+                    </span>
+                    <span className="inline-flex items-center gap-1">
+                      <i className="h-1.5 w-1.5 rounded-full bg-secondary" />F {Math.round(item.calculatedNutrition.fat)}g
+                    </span>
+                  </p>
+                </div>
+                <div className="flex flex-shrink-0 items-center gap-1">
+                  <span className="num text-sm font-semibold text-dark">
+                    {Math.round(item.calculatedNutrition.calories)}
+                    <span className="ml-0.5 text-xs font-normal text-muted">kcal</span>
+                  </span>
+                  <button
+                    onClick={() => onRemove(item.id)}
+                    aria-label={`Remove ${item.foodName || 'item'}`}
+                    className="rounded-lg p-1.5 text-muted opacity-100 transition hover:bg-warning-light hover:text-warning focus-visible:opacity-100 sm:opacity-0 sm:group-hover:opacity-100"
+                  >
+                    <X className="h-4 w-4" />
+                  </button>
+                </div>
+              </li>
+            ))}
+          </ul>
+          <div className="mt-2 flex gap-2 border-t border-border/50 pt-3">
+            <button onClick={() => onScan(slot)} className="btn-ghost btn-sm">
+              <Camera className="h-3.5 w-3.5" /> Scan
+            </button>
+            <button onClick={() => onAddFood(slot)} className="btn-ghost btn-sm">
+              <Plus className="h-3.5 w-3.5" /> Add food
+            </button>
+          </div>
+        </>
+      )}
+    </section>
+  );
+}
