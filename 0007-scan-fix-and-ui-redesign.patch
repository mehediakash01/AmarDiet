new file mode 100644
index 0000000..ddbbb71
--- /dev/null
+++ b/apps/web/components/ui/SyncStatus.tsx
@@ -0,0 +1,78 @@
+'use client';
+
+import { AlertTriangle, CheckCircle2, CloudOff, CloudUpload, Loader2 } from 'lucide-react';
+import { useSyncStatus, type SyncState } from '@/lib/sync/useSyncStatus';
+
+const COPY: Record<SyncState, { label: (n: number) => string; short: (n: number) => string; hint: string; tone: string; icon: typeof CheckCircle2 }> = {
+  synced: {
+    label: () => 'Saved & synced',
+    short: () => 'Synced',
+    hint: 'Everything is backed up to your account.',
+    tone: 'border-primary/20 bg-primary-light/70 text-primary',
+    icon: CheckCircle2,
+  },
+  syncing: {
+    label: () => 'Syncing…',
+    short: () => 'Syncing…',
+    hint: 'Sending your latest changes.',
+    tone: 'border-secondary/20 bg-secondary-light text-secondary',
+    icon: Loader2,
+  },
+  pending: {
+    label: (n) => `${n} change${n === 1 ? '' : 's'} waiting`,
+    short: (n) => `${n} waiting`,
+    hint: 'Saved on this device. Will sync shortly.',
+    tone: 'border-accent/30 bg-accent-light text-accent-hover',
+    icon: CloudUpload,
+  },
+  offline: {
+    label: () => 'Offline',
+    short: () => 'Offline',
+    hint: 'Keep logging — it is saved on this device and syncs when you reconnect.',
+    tone: 'border-border bg-sand text-muted',
+    icon: CloudOff,
+  },
+  error: {
+    label: (n) => `Couldn't sync ${n} change${n === 1 ? '' : 's'}`,
+    short: (n) => `${n} unsent`,
+    hint: 'Your entries are safe on this device. We will keep retrying.',
+    tone: 'border-warning/30 bg-warning-light text-warning',
+    icon: AlertTriangle,
+  },
+};
+
+export function SyncStatus({ variant = 'card' }: { variant?: 'card' | 'pill' }) {
+  const { state, pending, retry } = useSyncStatus();
+  const c = COPY[state];
+  const Icon = c.icon;
+  const canRetry = state === 'error' || state === 'pending';
+
+  if (variant === 'pill') {
+    return (
+      <div
+        role="status"
+        aria-live="polite"
+        title={c.hint}
+        className={`inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-medium ${c.tone}`}
+      >
+        <Icon className={`h-3.5 w-3.5 ${state === 'syncing' ? 'animate-spin' : ''}`} />
+        <span>{c.short(pending)}</span>
+      </div>
+    );
+  }
+
+  return (
+    <div role="status" aria-live="polite" className={`rounded-2xl border p-3 ${c.tone}`}>
+      <div className="flex items-center gap-2 text-sm font-semibold">
+        <Icon className={`h-4 w-4 flex-shrink-0 ${state === 'syncing' ? 'animate-spin' : ''}`} />
+        <span>{c.label(pending)}</span>
+      </div>
+      <p className="mt-1 text-xs leading-relaxed opacity-80">{c.hint}</p>
+      {canRetry && (
+        <button onClick={retry} className="mt-2 text-xs font-semibold underline underline-offset-2">
+          Sync now
+        </button>
+      )}
+    </div>
+  );
+}
