+interface FoodPick {
+  foodId: string;
+  qty: number;
+  unit: string;
+  role: 'base' | 'protein' | 'other';
+}
+
+function roundToNearest(value: number, step: number): number {
+  return Math.max(step, Math.round(value / step) * step);
+}
