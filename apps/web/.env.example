# Copy to apps/web/.env.local (gitignored) — only needed if the API is NOT at
# http://localhost:3001, e.g. when opening the site from your phone on the same
# Wi-Fi (use your computer's LAN IP, like http://192.168.1.20:3001) or when the
# API is deployed. Next.js bakes NEXT_PUBLIC_* values in at startup, so restart
# `pnpm dev:web` after changing it.
NEXT_PUBLIC_API_URL=http://localhost:3001
