# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Postgres connection string, from Neon. Without this set, the API silently
# falls back to in-memory storage (see app.ts) — fine for a quick local
# check, but data will NOT persist across restarts. Always set this for
# anything beyond a throwaway test run.
#
# Get this from your Neon project dashboard -> Connection Details.
# Neon gives you two variants:
#   - Pooled (recommended for the running app — has "-pooler" in the host)
#   - Direct/unpooled (recommended for running migrations)
# Both work fine here since this project uses the plain `postgres` driver
# over standard TCP, not Neon's special serverless HTTP driver.
#
# Example (replace with your real values from the Neon dashboard):
DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

PORT=3001
HOST=0.0.0.0

# AI meal-scan vision providers — each provider only activates if BOTH its
# key AND model name are set. Leave a provider's two lines commented out
# (or unset) to skip it entirely; the gateway just uses whichever
# providers ARE configured, in this order. Add a 4th/5th free provider
# later by writing one more adapter in apps/api/src/modules/ai/providers/
# and adding its two env vars here — nothing else needs to change.
#
# IMPORTANT: model names below are deliberately left blank, not defaulted.
# Vision model lineups on these platforms change every few months — check
# each provider's current docs right before deploying:
#   Gemini:     https://ai.google.dev/gemini-api/docs/models
#   Groq:       https://console.groq.com/docs/vision (their own docs warn
#               the multimodal lineup "changes frequently" — avoid Preview
#               models in production)
#   OpenRouter: https://openrouter.ai/models?modality=vision (filter to
#               free models — they rotate often)

GEMINI_API_KEY=
GEMINI_VISION_MODEL=

GROQ_API_KEY=
GROQ_VISION_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
