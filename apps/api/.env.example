# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Postgres connection string, from Neon. Without this set, the API silently
# falls back to in-memory storage (see app.ts) — fine for a quick local
# check, but data will NOT persist across restarts. Always set this for
# anything beyond a throwaway test run.
#
# Get this from your Neon project dashboard -> Connection Details.
# Neon gives you two variants:
#   - Pooled (recommended for the running app — has "-pooler" in the host)
#   - Direct/unpooled (recommended for running migrations)
# Both work fine here since this project uses the plain `postgres` driver
# over standard TCP, not Neon's special serverless HTTP driver.
#
# Example (replace with your real values from the Neon dashboard):
DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

PORT=3001
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# AI features (nutrition chatbot + photo meal scan)
# ---------------------------------------------------------------------------
# A provider is only used if BOTH its API key AND its model name are set.
# (Setting the key but leaving the model blank silently disables it — the
# server now prints a warning for that case.) You only need ONE provider;
# when several are configured they are tried in this order as fallbacks:
#   Gemini -> Groq -> OpenRouter -> Mistral  (Mistral has no meal-scan support)
#
# FASTEST PATH: get a free Gemini key at https://aistudio.google.com/apikey,
# paste it into GEMINI_API_KEY below, then run:   pnpm ai:check
#
# Model names go stale quickly — Gemini 1.5/2.0 are shut down, and several
# Groq models (llama-3.1-8b-instant, llama-3.3-70b-versatile,
# llama-4-scout) were retired in mid-2026. A wrong name shows up as a 404.
# `pnpm ai:check` tests every configured key and prints the model names that
# are actually available to you right now.
#
# After editing this file, restart the API (pnpm dev:api).
# Don't wrap values in quotes and don't commit the real .env.

# Gemini — "gemini-flash-latest" is an alias that follows Google's current
# Flash model, so it keeps working across model generations. It is
# multimodal, so the same name serves chat and meal scan.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_CHAT_MODEL=gemini-flash-latest

# Groq — fill in a current name from `pnpm ai:check` (vision-capable for
# GROQ_VISION_MODEL). Left blank on purpose: names rotate too often.
GROQ_API_KEY=
GROQ_VISION_MODEL=
GROQ_CHAT_MODEL=

# OpenRouter — free vision models rotate; `pnpm ai:check` lists the free ones.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_CHAT_MODEL=

# Mistral (chat only) — "-latest" aliases are stable.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
