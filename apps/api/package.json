{
  "name": "@thali/api",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed-food-data.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@thali/domain": "workspace:*",
    "@thali/food-data": "workspace:*",
    "@thali/nutrition-engine": "workspace:*",
    "@thali/schemas": "workspace:*",
    "@thali/types": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
